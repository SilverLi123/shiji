  "narrative": {
    "northStar": "清晰画廊上的采集层",
    "overview": "拾集的视觉重心是实际收藏的大图、名称与来源。暖白纸面、深绿文字和低饱和鼠尾草绿让内容自己的颜色进入画廊；系统字体承担持续搜索与整理的工作，不制造另一个展示品牌。\n\n玻璃用于操作层的浮起与上下文联系。macOS 原生采集浮层读取下方资源图像的颜色，标签和图标保持深色可读；浏览器使用明确的 CSS 材质近似。图片、正文和来源信息保持清晰。用户已否定割裂的 Olla 装饰循环与覆盖内容的大块白色磨砂面板。",
    "keyCharacteristics": [
      "实际资源图像提供主要视觉变化",
      "暖白纸面、鼠尾草绿操作、清晰深色文字",
      "小型原生操作浮层与稳定的内容平面",
      "动作触发的有限形变与可见键盘焦点"
    ],
    "rules": [
      {
        "name": "The Content Color Rule",
        "body": "让实际资源图像提供颜色；界面配色服务于搜索、选择和编辑，不补造装饰性主题色。",
        "section": "colors"
      },
      {
        "name": "The Clear Content Rule",
        "body": "玻璃属于操作层；资源预览与正文不附加磨砂、光晕或图像倾斜。",
        "section": "elevation"
      },
      {
        "name": "The Deliberate Motion Rule",
        "body": "形变回应明确操作或布局变化；不恢复自动循环的装饰舞台。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用实际封面、准确名称、真实数量和来源信息。",
      "Do 在深色和浅色图像上检查浮层标签与图标的可读性。",
      "Do 让控件保留可见焦点、明确动作名及加载、失败、禁用反馈。",
      "Do 保留原生材质、减少动态效果与不透明回退的区别。"
    ],
    "donts": [
      "Don’t 把 CSS backdrop-filter 称为原生 Liquid Glass。",
      "Don’t 恢复 Olla 循环装饰或在资源图像上叠加磨砂面板。",
      "Don’t 通过截图、示例封面或颜色推断资源的价格与许可。",
      "Don’t 将整个界面截图当作组件，或用外部图标依赖代替可独立渲染的图标。"
    ]
  }
}
